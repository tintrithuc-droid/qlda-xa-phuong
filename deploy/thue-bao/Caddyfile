# Cổng vào HTTPS: tự xin và gia hạn chứng chỉ (Let's Encrypt) cho từng tên miền của xã.
# Trước khi xin chứng chỉ, Caddy hỏi phần mềm (/api/tls-ask) xem tên miền đã đăng ký chưa, nên không ai lợi dụng được.
{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://app:8080/api/tls-ask
	}
}

https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	request_body {
		max_size 520MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	reverse_proxy app:8080
}

http:// {
	redir https://{host}{uri} permanent
}

# Trang web khác dùng chung cổng 80/443 của máy này (ví dụ một trang đang chạy trên máy IIS trong mạng):
# mỗi tệp them/<tên>.caddy là một khối, ví dụ
#   ttts.example.vn {
#   	reverse_proxy http://192.168.0.23:80
#   }
# Tên miền ghi rõ ở đây được cấp chứng chỉ bình thường, ưu tiên hơn khối https:// chung ở trên.
import /etc/caddy/them/*.caddy
