@{ Layout = null; }
<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>@ViewData["Title"]</title>
<meta name="description" content="@ViewData["Desc"]">
<meta name="theme-color" content="@ViewData["Theme"]">
<link rel="manifest" href="/api/branding/manifest.webmanifest">
@if (ViewData["Icon"] is string icon)
{
<link rel="icon" href="@icon" id="favicon">
<link rel="apple-touch-icon" href="@icon">
}
else
{
<link rel="icon" href="~/icons/icon.svg" type="image/svg+xml" id="favicon">
<link rel="apple-touch-icon" href="~/icons/icon-192.png">
}
<link rel="stylesheet" href="~/css/app.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/congnghe.css" asp-append-version="true">
</head>
<body>
<div id="root"></div>
<div id="ov" class="ov" hidden></div>
<div id="toast" class="toast" hidden></div>
<script src="~/lib/xlsx.full.min.js"></script>
<script src="~/js/seed.js" asp-append-version="true"></script>
<script src="~/js/core.js" asp-append-version="true"></script>
<script src="~/js/views-1.js" asp-append-version="true"></script>
<script src="~/js/views-2.js" asp-append-version="true"></script>
<script src="~/js/views-3.js" asp-append-version="true"></script>
<script src="~/js/views-4.js" asp-append-version="true"></script>
<script src="~/js/import.js" asp-append-version="true"></script>
<script src="~/js/opening.js" asp-append-version="true"></script>
<script src="~/js/views-vp.js" asp-append-version="true"></script>
<script src="~/js/views-vp2.js" asp-append-version="true"></script>
<script>if('serviceWorker' in navigator) addEventListener('load',()=>navigator.serviceWorker.register('/sw.js').catch(()=>{}));</script>
</body>
</html>
