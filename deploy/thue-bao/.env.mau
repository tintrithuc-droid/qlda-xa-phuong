# Sao thành .env rồi sửa (cai-dat.sh tự tạo .env nếu chưa có)
BASE_DOMAIN=qlda.trithuc.vn
ACME_EMAIL=kythuat@trithuc.vn
PG_PASSWORD=doi-mat-khau-dai-ngau-nhien
PG_MAX_CONNECTIONS=400
PG_SHARED_BUFFERS=1GB
QLDA_IMAGE=qlda-xa-phuong:latest
# Sao lưu tập trung (sao-luu.sh)
BACKUP_DIR=/srv/qlda-saoluu
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_MONTHS=12
# Bản sao ngoài máy chủ, mã hóa bằng restic (để trống nếu chưa có): ví dụ sftp:saoluu@10.0.0.9:/kho/qlda hoặc s3:https://...
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
# Cảnh báo (kiem-tra.sh): địa chỉ nhận tin, ví dụ Telegram https://api.telegram.org/bot<token>/sendMessage?chat_id=<id>
ALERT_URL=
